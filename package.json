{
  "name": "tec-qs-contacts",
  "version": "1.0.0",
  "description": "Sistema Institucional de Gestión de Contactos Académicos y Empleadores para el Ranking QS - Tecnológico de Costa Rica (TEC)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/test_suite.js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/css/tailwind.css --minify",
    "package:azure": "node scripts/package-azure.js"
  },
  "keywords": [
    "tec",
    "qs-ranking",
    "contacts",
    "academic-reputation",
    "employer-reputation"
  ],
  "author": "Tecnológico de Costa Rica",
  "license": "Proprietary",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
