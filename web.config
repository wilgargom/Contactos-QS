<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="ContactosQS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Todas las solicitudes pasan por Node, incluso los archivos públicos.
         IIS nunca debe servir src/, storage/ o package.json directamente. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="36700160" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode nodeProcessCountPerApplication="1" devErrorsEnabled="false" />
  </system.webServer>
</configuration>
